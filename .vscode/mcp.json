{
	"servers": {
		"github-mcp": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${input:github_token}"
			}
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"Authorization": "Bearer ${input:context7_api_key}"
			}
		}
	},
	"inputs": [
		{
			"id": "github_token",
			"type": "promptString",
			"description": "GitHub personal access token (classic, ghp_...) with 'repo' scope for jackmurphyslalom/yugastore-java",
			"password": true
		},
		{
			"id": "context7_api_key",
			"type": "promptString",
			"description": "Context7 API key (free, from https://context7.com/dashboard) for up-to-date library/framework docs",
			"password": true
		}
	]
}
